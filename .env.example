# Optional: override the primary Piped API instance.
PIPED_BASE_URL=https://pipedapi.kavin.rocks

# Optional: comma-separated fallback instances. Keep these checked/maintained because public instances can change.
PIPED_FALLBACK_URLS=https://pipedapi.leptons.xyz,https://pipedapi.nosebs.ru

# Optional per-instance request timeout in milliseconds (bounded server-side to avoid slow functions).
PIPED_TIMEOUT_MS=1900
